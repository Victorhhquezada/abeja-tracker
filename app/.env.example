# Copiar a .env para desarrollo local (netlify dev lo carga automático)
# En producción, configurar estas mismas variables en Netlify > Site settings > Environment variables

# Contraseña para entrar al dashboard
APP_PASSWORD=cambia-esto

# Secreto para firmar el token de sesión (cualquier string largo y random)
APP_TOKEN_SECRET=cambia-esto-tambien-bien-largo
